<mujoco model="planar articulated biped">
  <compiler angle="radian"/>
  <option timestep=".001" gravity="0 0 -9.81" integrator="implicitfast" iterations="80" tolerance="1e-10"/>
  <visual><global offwidth="960" offheight="720"/><headlight ambient=".5 .5 .5"/></visual>
  <default>
    <joint damping=".15" armature=".02"/>
    <geom contype="0" conaffinity="0" friction=".8 .005 .0001" solref=".008 1" solimp=".95 .99 .001"/>
    <default class="hip"><joint range="-1.5 1.0"/></default>
    <default class="knee"><joint range=".02 2.3"/></default>
    <default class="ankle"><joint range="-1.3 1.0"/></default>
  </default>
  <worldbody>
    <light pos="0 -3 4" dir="0 .5 -1"/>
    <geom name="ground" type="plane" size="5 3 .1" contype="1" conaffinity="1" rgba=".85 .89 .92 1"/>
    <body name="pelvis" pos="0 0 .76">
      <joint name="base_x" type="slide" axis="1 0 0" damping="0" armature="0" limited="false"/>
      <joint name="base_z" type="slide" axis="0 0 1" damping="0" armature="0" limited="false"/>
      <joint name="base_pitch" type="hinge" axis="0 1 0" damping="0" armature="0" limited="false"/>
      <geom name="torso" type="box" pos="0 0 .10" size=".10 .10 .14" mass="20" rgba=".15 .46 .64 1"/>
      <body name="left_thigh" pos="0 .075 0">
        <joint name="left_hip" type="hinge" axis="0 1 0" class="hip" limited="true"/>
        <geom type="capsule" fromto="0 0 0 0 0 -.4" size=".028" mass="2" rgba=".25 .55 .72 1"/>
        <body name="left_shin" pos="0 0 -.4">
          <joint name="left_knee" type="hinge" axis="0 1 0" class="knee" limited="true"/>
          <geom type="capsule" fromto="0 0 0 0 0 -.4" size=".023" mass="1" rgba=".35 .65 .80 1"/>
          <body name="left_foot" pos="0 0 -.4">
            <joint name="left_ankle" type="hinge" axis="0 1 0" class="ankle" limited="true"/>
            <geom name="left_sole_geom" type="box" pos=".04 0 -.025" size=".10 .045 .025" mass=".6" contype="1" conaffinity="1" rgba=".10 .28 .45 1"/>
            <site name="left_sole" pos=".04 0 -.05" size=".008"/>
          </body>
        </body>
      </body>
      <body name="right_thigh" pos="0 -.075 0">
        <joint name="right_hip" type="hinge" axis="0 1 0" class="hip" limited="true"/>
        <geom type="capsule" fromto="0 0 0 0 0 -.4" size=".028" mass="2" rgba=".67 .37 .23 1"/>
        <body name="right_shin" pos="0 0 -.4">
          <joint name="right_knee" type="hinge" axis="0 1 0" class="knee" limited="true"/>
          <geom type="capsule" fromto="0 0 0 0 0 -.4" size=".023" mass="1" rgba=".77 .48 .32 1"/>
          <body name="right_foot" pos="0 0 -.4">
            <joint name="right_ankle" type="hinge" axis="0 1 0" class="ankle" limited="true"/>
            <geom name="right_sole_geom" type="box" pos=".04 0 -.025" size=".10 .045 .025" mass=".6" contype="1" conaffinity="1" rgba=".4 .20 .12 1"/>
            <site name="right_sole" pos=".04 0 -.05" size=".008"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor joint="left_hip" gear="1" ctrllimited="true" ctrlrange="-80 80"/>
    <motor joint="left_knee" gear="1" ctrllimited="true" ctrlrange="-80 80"/>
    <motor joint="left_ankle" gear="1" ctrllimited="true" ctrlrange="-30 30"/>
    <motor joint="right_hip" gear="1" ctrllimited="true" ctrlrange="-80 80"/>
    <motor joint="right_knee" gear="1" ctrllimited="true" ctrlrange="-80 80"/>
    <motor joint="right_ankle" gear="1" ctrllimited="true" ctrlrange="-30 30"/>
  </actuator>
</mujoco>
